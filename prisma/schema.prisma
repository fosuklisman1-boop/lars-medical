// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Client model for clinic management system
// Each client gets a unique ID starting with "LMC" (Lars Medical Centre)
model Client {
  id                    String    @id @default(cuid())
  // Unique client ID in format: LMC-XXXXXX (generated automatically)
  clientId              String    @unique
  
  // Personal Information
  name                  String
  sex                   String    // MALE, FEMALE, OTHER
  age                   Int
  address               String?
  dateOfRegistration    DateTime  @default(now())
  
  // Medical Information
  refDoctor             String?   // Referring Doctor
  procedure             String?   // Type of procedure/operation
  operationTeam         String[]  // Array of team members
  
  // Procedure Details
  timeStarted           DateTime?
  timeEnded             DateTime?
  medicationGiven       String?
  instrumentsUsed       String[]  // Array of instruments
  
  // Clinical Findings
  clinicalSummary       String?
  findings              String?   // Detailed findings from procedure
  
  // Test Results
  hutTestResult         String?   // HUT test result
  impression            String?   // Medical impression/diagnosis
  
  // Treatment & Recommendations
  comments              String?   // Doctor's comments
  medication            String?   // Prescribed medication
  
  // Metadata
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([clientId])
  @@index([name])
  @@index([dateOfRegistration])
}
